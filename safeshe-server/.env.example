# Copy to .env (git-ignored) for local runs. On Vercel, set these in Project → Settings → Environment Variables.
# Postgres connection. On Vercel, Storage → Neon sets DATABASE_URL / POSTGRES_URL automatically.
DATABASE_URL=postgres://user:password@localhost:5432/safeshe
# Admin login for the admin panel (set the password on the host, never commit it).
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=
# Set to 1 for one deploy to force-reset the admin password to ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD=0
# 2Factor.in API key for real OTP SMS. Empty = TEST MODE (codes shown in Admin → Settings).
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# TEST ONLY: also show the OTP inside the app. Never enable on a public deployment.
OTP_SHOW_IN_APP=0
# Public https address (used in live-trip links). On Vercel it defaults to the production domain.
PUBLIC_URL=
# Contact email sent to OpenStreetMap services in the User-Agent (their usage policy asks for one).
CONTACT_EMAIL=
DISPATCH_RADIUS_KM=6
SEARCH_TIMEOUT_SEC=120
